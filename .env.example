# Root-level reference. Each service has its own .env inside backend/ and frontend/.
# This file documents the full set of variables used across the monorepo.

# === Backend ===
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Supabase (backend uses service_role key — never expose to frontend)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Storage: "supabase" (default, uses Supabase Storage) or "gcs"
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=vault-files

# Optional: Google Cloud Storage (only if STORAGE_PROVIDER=gcs)
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEY_FILE=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# === Frontend ===
VITE_API_URL=http://localhost:3000
