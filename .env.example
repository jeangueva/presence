# Root-level reference. Each service has its own .env inside backend/ and frontend/.
# This file documents the full set of variables used across the monorepo.

# === Backend ===
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Supabase (backend uses service_role key — never expose to frontend)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Storage: "supabase" (default, uses Supabase Storage) or "gcs"
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=vault-files

# Optional: Google Cloud Storage (only if STORAGE_PROVIDER=gcs)
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEY_FILE=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# === Frontend ===
VITE_API_URL=http://localhost:3000

# === Billing (MercadoPago) ===
# Legado = pago único, Vault = mensual. Montos en moneda LOCAL.
# App "Checkout API" — vende Legado (pago único) con Checkout Bricks.
# La public key va al navegador; el access token nunca.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# App "Suscripciones" — vende Vault IA (mensual). Si se dejan vacías, se
# reutilizan las credenciales de arriba.
MERCADOPAGO_SUBSCRIPTION_ACCESS_TOKEN=
MERCADOPAGO_SUBSCRIPTION_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=COP
MERCADOPAGO_PRICE_LEGADO=396000
MERCADOPAGO_PRICE_VAULT=48000

# Public URL where MercadoPago posts webhooks (ngrok in dev).
BACKEND_PUBLIC_URL=

# Shared secret for admin ops, including the daily dead-man's-switch sweep.
ADMIN_TOKEN=
