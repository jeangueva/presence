NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Whisper transcription. Elige UN proveedor:
# - Groq (recomendado): free tier + más rápido. https://console.groq.com
# - OpenAI: fallback. https://platform.openai.com/api-keys
# Si ambos están vacíos, audios se suben pero no se transcriben.
GROQ_API_KEY=
OPENAI_API_KEY=
# Override de modelo. Default: whisper-large-v3-turbo (Groq) o whisper-1 (OpenAI).
WHISPER_MODEL=

# Email (Resend). Si RESEND_API_KEY está vacío, los emails caen a console.log.
RESEND_API_KEY=
EMAIL_FROM=Presence <onboarding@resend.dev>

# MercadoPago — billing. Saca el Access Token en
# https://www.mercadopago.com/developers/panel (modo Test o Producción).
# Si MERCADOPAGO_ACCESS_TOKEN está vacío, los endpoints de billing devuelven un error claro.
MERCADOPAGO_ACCESS_TOKEN=
# (opcional) secret para validar la firma de los webhooks que llegan a /billing/webhook
MERCADOPAGO_WEBHOOK_SECRET=
# Moneda local soportada por tu cuenta MP. Ej: COP, MXN, ARS, BRL, CLP, PEN, UYU.
MERCADOPAGO_CURRENCY=COP
# Montos mensuales en moneda LOCAL (no USD). Ej: 36000 COP, 199 MXN, 9000 ARS.
MERCADOPAGO_PRICE_PERSONAL=36000
MERCADOPAGO_PRICE_FAMILY=76000
# URL pública del backend (donde MP entregará los webhooks).
# En dev usa ngrok o cloudflared. En prod, tu API en producción.
BACKEND_PUBLIC_URL=https://tu-backend-publico.example

STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=vault-files

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
